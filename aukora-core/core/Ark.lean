namespace Aukora.Ark

-- A byte is a polynomial over GF(2), bit 0 is the constant term. Multiplication by x
-- shifts and, when x^8 was set, reduces by x^8 + x^4 + x^3 + x^2 + 1 (0x11d).
def timesX (a : UInt8) : UInt8 :=
  if a &&& 128 == 0 then a <<< 1 else (a <<< 1) ^^^ 0x1d

def mulBits : Nat → UInt8 → UInt8 → UInt8
  | 0, _, _ => 0
  | n+1, a, b =>
    let rest := mulBits n (timesX a) (b >>> 1)
    if b &&& 1 == 0 then rest else rest ^^^ a

def mul (a b : UInt8) : UInt8 := mulBits 8 a b
def delta (i j : Nat) : UInt8 := if i = j then 1 else 0

-- Outside the identity rows, x = row-4 and y = column+6 have disjoint ranges.
-- This table gives reciprocals of the small denominators x XOR y used below.
def inverseSmall (n : Nat) : UInt8 :=
  [0,1,142,244,71,167,122,186,173,157,221,152,61,170,93,150][n]?.getD 0

def coeff (row col : Nat) : UInt8 :=
  if row < 4 then delta row col else inverseSmall ((row - 4) ^^^ (col + 6))

def labels (mask : Nat) := (List.range 10).filter (fun r => mask.testBit r)
def columns := List.range 4
def dot (basis : List Nat) (f : Nat → UInt8) : UInt8 :=
  basis.foldr (fun k sum => f k ^^^ sum) 0

-- The row coordinates of the minor are the original row labels. The left product
-- acts on selected rows and the right product acts on the four source coordinates.
def TwoSided (rows : List Nat) (b : Nat → Nat → UInt8) : Prop :=
  (∀ i ∈ rows, ∀ j ∈ rows, dot columns (fun k => mul (coeff i k) (b k j)) = delta i j) ∧
  (∀ i ∈ columns, ∀ j ∈ columns, dot rows (fun r => mul (b i r) (coeff r j)) = delta i j)

def checksProducts (rows : List Nat) (b : Nat → Nat → UInt8) : Bool :=
  rows.all (fun i => rows.all (fun j => dot columns (fun k => mul (coeff i k) (b k j)) == delta i j)) &&
  columns.all (fun i => columns.all (fun j => dot rows (fun r => mul (b i r) (coeff r j)) == delta i j))

theorem checksProducts_spec (rows b) : checksProducts rows b = true ↔ TwoSided rows b := by
  simp [checksProducts, TwoSided]
#print axioms checksProducts_spec

-- Verify the Cauchy denominators in both multiplication orders using polynomial arithmetic.
theorem cauchy_entries :
    (List.range 6).all (fun x => columns.all (fun j =>
      let d := (x ^^^ (j+6)).toUInt8
      let a := coeff (x+4) j
      d != 0 && mul d a == 1 && mul a d == 1)) = true := by decide
#print axioms cauchy_entries

