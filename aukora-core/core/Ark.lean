def inverseAt (mask i r : Nat) : UInt8 :=
  (packed[mask]?.getD 0 >>> (8 * (10*i + r))).toUInt8

def checkedMask (mask : Nat) : Bool :=
  let rows := labels mask
  if rows.length = 4 then checksProducts rows (inverseAt mask) else true

set_option maxRecDepth 8192 in
set_option maxHeartbeats 1600000 in
theorem all_masks : (List.range 1024).all checkedMask = true := by decide
#print axioms all_masks

-- Every four-element subset of the ten row labels has a two-sided inverse.
-- A bitmask names a set, so this covers selections supplied in any order.
theorem every_four_rows (mask : Fin 1024) (four : (labels mask.val).length = 4) :
    ∃ b, TwoSided (labels mask.val) b := by
  have h := List.all_eq_true.mp all_masks mask.val (List.mem_range.mpr mask.isLt)
  exact ⟨inverseAt mask.val, (checksProducts_spec _ _).mp (by simpa [checkedMask, four] using h)⟩
