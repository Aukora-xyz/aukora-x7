;; menger-hive.wat : the 80-site Menger sponge skeleton and its 80-site plain two-sided control in one cell
;; (the Menger hive, docs/auma/menger-hive.md). Hand-written integer cell, Microverse ABI v1 guest. i32 and i64 only.
;; No imports. Four pages of linear storage, fixed. An instrument with no authority: it computes one tick of the
;; detuned wave law mod P = 65,521 as a single-host monolith or across a rank-7 1-organ / 4-organ+corners split,
;; and it signs nothing, stores nothing, and claims zero privacy.
;;
;; Field P = 65,521. Both wirings ("menger" = 0, "plain" = 1) have 80 sites (0..19 shared corners of degree 6;
;; 20 + 12*k .. 20 + 12*k + 11 private sites of organ k = 0..4, each of degree 2), 120 bipartite links, cycle rank 41,
;; detuning d[i] in 0..10, Laplacian L = Adj - Deg - diag(d), state [q0..q79, p0..p79] (160 words in 0..65520), and
;; inlet at shared corner 0:
;;   p' = (p + L*q + b*u) mod P,   q' = (q + p') mod P,   where b[0] = 1 and b[i>0] = 0.
;;
;; For each wiring w in {0, 1} and organ k in 0..4, Sa is organ k's 24 words [q(s0..s0+11), p(s0..s0+11)] (s0 = 20+12*k)
;; and Sb is the remaining 136 words [q_b(68), p_b(68)] in ascending site order (so Sb[0..19] are q[0..19] and
;; Sb[68..87] are p[0..19]). Both off-diagonal coupling blocks M[Sa, Sb] and M[Sb, Sa] have exact rank 7 over F_65521:
;;   M[Sa, Sb] = Fa_k * Ra_k   (7 words into organ k: msgIn = Ra_k * xb mod P),
;;   M[Sb, Sa] = Fb_k * Rb_k   (7 words out of organ k: msgOut = Rb_k * xa mod P).
;;
;; Ops (canonical JSON in and out, keys in UTF-8 byte order):
;;   hive.info          {} -> {boundaryWords, corners, cycleRank, field, horizonTicks, links, organWords, organs,
;;                             sites, stateWords, tableSha256, wirings, wiringsSha256}
;;   hive.step_monolith {input, state[160], wiring} -> {corners[20], nextState[160], stateSha256}
;;   hive.boundary      {bodyState[136], edgeOrgan, wiring} -> {msgToEdge[7]}
;;   hive.step_organ    {input, msgIn[7], organ, organState[24], wiring} -> {msgOut[7], nextOrganState[24], organSha256}
;;   hive.step_body     {bodyState[136], edgeOrgan, input, msgFromEdge[7], wiring} -> {bodySha256, corners[20], nextBodyState[136]}
;;
;; Refusals (closed; when several hold, the lowest number wins):
;;   1 MALFORMED  2 OP_UNKNOWN  3 HIVE_SHAPE  4 HIVE_WIRING_UNKNOWN  5 HIVE_ORGAN_RANGE  6 HIVE_WORD_RANGE
;;
;; Storage map (bytes):
;;   64..1695      text literals, NUL-terminated; refusal code c at 1472 + 32*c
;;   1728..1759    tableSha256 (32 raw bytes, set by server/menger-hive-cell.build.mjs)
;;   1760..1791    wiringsSha256 (32 raw bytes, set by server/menger-hive-cell.build.mjs)
;;   2048..2655    SHA-256 constants K 2048, H 2304, block 2336, W 2400 (nucleus.wat's routine)
;;   2688..2719    computed SHA-256 digest (32 bytes)
;;   3200..3263    decimal digit scratch
;;   4096..13855   baked tables (2 wirings * 4,880 bytes = 9,760 bytes; w=0 menger at 4096, w=1 plain at 8976):
;;                   +0..239   120 edges as (u8, u8)
;;                   +240..319 80 degrees as u8
;;                   +320..399 80 detunings as u8
;;                   +400 + 896*k (k = 0..4):
;;                     +0..279   Ra20 (7 x 20 u16le)
;;                     +280..447 Fa12 (12 x 7 u16le)
;;                     +448..615 Rb12 (7 x 12 u16le)
;;                     +616..895 Fb20 (20 x 7 u16le)
;;   14336..14975  fullIn (160 x i32)
;;   14976..15615  fullOut (160 x i32)
;;   15616..16159  bodyBuf (136 x i32)
;;   16160..16255  organBuf (24 x i32)
;;   16256..16283  msgBuf (7 x i32)
;;   16288..16315  msgOutBuf (7 x i32)
;;   16384..32767  request (mv_alloc);  65536.. response
(module
  (memory (export "memory") 4 4)

  (global $p (mut i32) (i32.const 0))        ;; parse cursor
  (global $end (mut i32) (i32.const 0))      ;; end of request
  (global $errs (mut i32) (i32.const 0))     ;; one bit per refusal code
  (global $bad (mut i32) (i32.const 0))      ;; request text failed syntax parse
  (global $failcode (mut i32) (i32.const 1)) ;; MALFORMED in envelope, HIVE_SHAPE inside input
  (global $seq (mut i64) (i64.const 0))
  (global $o (mut i32) (i32.const 65536))    ;; response cursor
  (global $fill (mut i32) (i32.const 0))     ;; SHA-256 block fill
  (global $len (mut i64) (i64.const 0))      ;; SHA-256 message length
  (global $w (mut i32) (i32.const 0))        ;; parsed wiring: 0 = menger, 1 = plain
  (global $organ (mut i32) (i32.const 0))    ;; parsed organ / edgeOrgan: 0..4
  (global $u (mut i32) (i32.const 0))        ;; parsed scalar input word: 0..65520

