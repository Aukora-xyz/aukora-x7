      (local.set $e (i32.add (local.get $d) (local.get $t1)))
      (local.set $d (local.get $c))
      (local.set $c (local.get $b))
      (local.set $b (local.get $a))
      (local.set $a (i32.add (local.get $t1) (local.get $t2)))
      (local.set $t (i32.add (local.get $t) (i32.const 1)))
      (br_if $r (i32.lt_u (local.get $t) (i32.const 64))))
    (i32.store offset=2304 (i32.const 0) (i32.add (i32.load offset=2304 (i32.const 0)) (local.get $a)))
    (i32.store offset=2308 (i32.const 0) (i32.add (i32.load offset=2308 (i32.const 0)) (local.get $b)))
    (i32.store offset=2312 (i32.const 0) (i32.add (i32.load offset=2312 (i32.const 0)) (local.get $c)))
    (i32.store offset=2316 (i32.const 0) (i32.add (i32.load offset=2316 (i32.const 0)) (local.get $d)))
    (i32.store offset=2320 (i32.const 0) (i32.add (i32.load offset=2320 (i32.const 0)) (local.get $e)))
    (i32.store offset=2324 (i32.const 0) (i32.add (i32.load offset=2324 (i32.const 0)) (local.get $f)))
    (i32.store offset=2328 (i32.const 0) (i32.add (i32.load offset=2328 (i32.const 0)) (local.get $g)))
    (i32.store offset=2332 (i32.const 0) (i32.add (i32.load offset=2332 (i32.const 0)) (local.get $h))))

  (func $sha_byte (param $b i32)
    (i32.store8 offset=2336 (global.get $fill) (local.get $b))
    (global.set $fill (i32.add (global.get $fill) (i32.const 1)))
    (global.set $len (i64.add (global.get $len) (i64.const 1)))
    (if (i32.eq (global.get $fill) (i32.const 64))
      (then (call $sha_block) (global.set $fill (i32.const 0)))))

  (func $sha_final (param $out i32)
    (local $bits i64) (local $k i32)
    (local.set $bits (i64.shl (global.get $len) (i64.const 3)))
    (call $sha_byte (i32.const 128))
    (block $d (loop $l
      (br_if $d (i32.eq (global.get $fill) (i32.const 56)))
      (call $sha_byte (i32.const 0))
      (br $l)))
    (local.set $k (i32.const 56))
    (loop $lb
      (call $sha_byte (i32.wrap_i64 (i64.and (i64.shr_u (local.get $bits) (i64.extend_i32_u (local.get $k))) (i64.const 255))))
      (local.set $k (i32.sub (local.get $k) (i32.const 8)))
      (br_if $lb (i32.ge_s (local.get $k) (i32.const 0))))
    (local.set $k (i32.const 0))
    (loop $lo
      (i32.store (i32.add (local.get $out) (local.get $k)) (call $bswap (i32.load offset=2304 (local.get $k))))
      (local.set $k (i32.add (local.get $k) (i32.const 4)))
      (br_if $lo (i32.lt_u (local.get $k) (i32.const 32)))))

  ;; SHA-256 over $n i32 words at $src serialized as u16 little-endian into $out (32 bytes).
  (func $words_sha (param $src i32) (param $n i32) (param $out i32)
    (local $i i32) (local $v i32)
    (call $sha_init)
    (block $d (loop $l
      (br_if $d (i32.ge_u (local.get $i) (local.get $n)))
      (local.set $v (i32.load (i32.add (local.get $src) (i32.shl (local.get $i) (i32.const 2)))))
      (call $sha_byte (i32.and (local.get $v) (i32.const 255)))
      (call $sha_byte (i32.and (i32.shr_u (local.get $v) (i32.const 8)) (i32.const 255)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l)))
    (call $sha_final (local.get $out)))

  ;; ================= the wave & rank-7 boundary machine =================
  (func $zero_full_in
    (local $k i32)
    (block $d (loop $l
      (br_if $d (i32.ge_u (local.get $k) (i32.const 640)))
      (i32.store (i32.add (i32.const 14336) (local.get $k)) (i32.const 0))
      (local.set $k (i32.add (local.get $k) (i32.const 4)))
      (br $l))))

  ;; Wiring table base: 4096 + 4880 * $w.
  (func $wbase (param $w i32) (result i32)
    (i32.add (i32.const 4096) (i32.mul (local.get $w) (i32.const 4880))))

  ;; Organ rank-7 block base: wbase($w) + 400 + 896 * $k.
  (func $obase (param $w i32) (param $k i32) (result i32)
    (i32.add (i32.add (call $wbase (local.get $w)) (i32.const 400))
             (i32.mul (local.get $k) (i32.const 896))))

  ;; Advance fullIn (14336..14975) by 1 tick of wiring $w with corner-0 drive $u into fullOut (14976..15615).
  (func $apply_M_and_drive (param $w i32) (param $u i32)
    (local $base i32) (local $i i32) (local $a i32) (local $b i32)
    (local $qi i32) (local $pi i32) (local $dd i32) (local $pn i32)
    (local.set $base (call $wbase (local.get $w)))
    ;; 1. np[i] = pi + 16*65521 - (deg[i] + det[i]) * qi (+ $u if i == 0)
    (local.set $i (i32.const 0))
    (loop $init
      (local.set $qi (i32.load (i32.add (i32.const 14336) (i32.shl (local.get $i) (i32.const 2)))))
      (local.set $pi (i32.load (i32.add (i32.const 14656) (i32.shl (local.get $i) (i32.const 2)))))
      (local.set $dd (i32.add
        (i32.load8_u (i32.add (i32.add (local.get $base) (i32.const 240)) (local.get $i)))
        (i32.load8_u (i32.add (i32.add (local.get $base) (i32.const 320)) (local.get $i)))))
      (local.set $pn (i32.sub (i32.add (local.get $pi) (i32.const 1048336))
                              (i32.mul (local.get $dd) (local.get $qi))))
      (if (i32.eqz (local.get $i))
        (then (local.set $pn (i32.add (local.get $pn) (local.get $u)))))
      (i32.store (i32.add (i32.const 15296) (i32.shl (local.get $i) (i32.const 2))) (local.get $pn))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $init (i32.lt_u (local.get $i) (i32.const 80))))
    ;; 2. Accumulate undirected adjacency over all 120 edges
    (local.set $i (i32.const 0))
    (loop $edges
      (local.set $a (i32.load8_u (i32.add (local.get $base) (i32.shl (local.get $i) (i32.const 1)))))
      (local.set $b (i32.load8_u (i32.add (i32.add (local.get $base) (i32.const 1)) (i32.shl (local.get $i) (i32.const 1)))))
      (i32.store (i32.add (i32.const 15296) (i32.shl (local.get $a) (i32.const 2)))
        (i32.add (i32.load (i32.add (i32.const 15296) (i32.shl (local.get $a) (i32.const 2))))
                 (i32.load (i32.add (i32.const 14336) (i32.shl (local.get $b) (i32.const 2))))))
      (i32.store (i32.add (i32.const 15296) (i32.shl (local.get $b) (i32.const 2)))
        (i32.add (i32.load (i32.add (i32.const 15296) (i32.shl (local.get $b) (i32.const 2))))
                 (i32.load (i32.add (i32.const 14336) (i32.shl (local.get $a) (i32.const 2))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $edges (i32.lt_u (local.get $i) (i32.const 120))))
    ;; 3. Reduce p'[i] mod 65521 and compute q'[i] = (q[i] + p'[i]) mod 65521
    (local.set $i (i32.const 0))
    (loop $fin
      (local.set $pn (i32.rem_u
        (i32.load (i32.add (i32.const 15296) (i32.shl (local.get $i) (i32.const 2))))
        (i32.const 65521)))
      (i32.store (i32.add (i32.const 15296) (i32.shl (local.get $i) (i32.const 2))) (local.get $pn))
      (local.set $qi (i32.load (i32.add (i32.const 14336) (i32.shl (local.get $i) (i32.const 2)))))
      (i32.store (i32.add (i32.const 14976) (i32.shl (local.get $i) (i32.const 2)))
        (i32.rem_u (i32.add (local.get $qi) (local.get $pn)) (i32.const 65521)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $fin (i32.lt_u (local.get $i) (i32.const 80)))))

  ;; Multiply u16le matrix ($rows x $cols) at $mat by i32 vector ($cols) at $vec mod 65521 into i32 vector ($rows) at $dst.
  (func $matvec (param $mat i32) (param $rows i32) (param $cols i32) (param $vec i32) (param $dst i32)
    (local $r i32) (local $c i32) (local $sum i64) (local $m i64) (local $v i64)
    (block $dr (loop $lr
      (br_if $dr (i32.ge_u (local.get $r) (local.get $rows)))
      (local.set $sum (i64.const 0))
      (local.set $c (i32.const 0))
      (block $dc (loop $lc
        (br_if $dc (i32.ge_u (local.get $c) (local.get $cols)))
        (local.set $m (i64.extend_i32_u (i32.load16_u
          (i32.add (local.get $mat) (i32.shl (i32.add (i32.mul (local.get $r) (local.get $cols)) (local.get $c)) (i32.const 1))))))
        (local.set $v (i64.extend_i32_u (i32.load
          (i32.add (local.get $vec) (i32.shl (local.get $c) (i32.const 2))))))
        (local.set $sum (i64.add (local.get $sum) (i64.mul (local.get $m) (local.get $v))))
        (local.set $c (i32.add (local.get $c) (i32.const 1)))
        (br $lc)))
      (i32.store (i32.add (local.get $dst) (i32.shl (local.get $r) (i32.const 2)))
        (i32.wrap_i64 (i64.rem_u (local.get $sum) (i64.const 65521))))
      (local.set $r (i32.add (local.get $r) (i32.const 1)))
      (br $lr))))

  ;; ================= response writing =================
  (func $putc (param $c i32)
    (i32.store8 (global.get $o) (local.get $c))
    (global.set $o (i32.add (global.get $o) (i32.const 1))))

  (func $puts (param $a i32)
    (local $c i32)
    (block $done
      (loop $next
        (local.set $c (i32.load8_u (local.get $a)))
        (br_if $done (i32.eqz (local.get $c)))
        (call $putc (local.get $c))
        (local.set $a (i32.add (local.get $a) (i32.const 1)))
        (br $next))))

  (func $putu (param $v i64)
    (local $q i32)
    (local.set $q (i32.const 3264))
    (loop $next
      (local.set $q (i32.sub (local.get $q) (i32.const 1)))
      (i32.store8 (local.get $q)
        (i32.add (i32.const 48) (i32.wrap_i64 (i64.rem_u (local.get $v) (i64.const 10)))))
      (local.set $v (i64.div_u (local.get $v) (i64.const 10)))
      (br_if $next (i64.ne (local.get $v) (i64.const 0))))
    (block $done
      (loop $copy
        (br_if $done (i32.ge_u (local.get $q) (i32.const 3264)))
        (call $putc (i32.load8_u (local.get $q)))
        (local.set $q (i32.add (local.get $q) (i32.const 1)))
        (br $copy))))

  (func $puti (param $v i32) (call $putu (i64.extend_i32_u (local.get $v))))

  (func $hexc (param $x i32) (result i32)
    (select (i32.add (i32.const 48) (local.get $x)) (i32.add (i32.const 87) (local.get $x))
      (i32.lt_u (local.get $x) (i32.const 10))))

  (func $puthex (param $a i32)
    (local $k i32) (local $b i32)
    (call $putc (i32.const 34))
    (block $d (loop $l
      (br_if $d (i32.ge_u (local.get $k) (i32.const 32)))
      (local.set $b (i32.load8_u (i32.add (local.get $a) (local.get $k))))
      (call $putc (call $hexc (i32.shr_u (local.get $b) (i32.const 4))))
      (call $putc (call $hexc (i32.and (local.get $b) (i32.const 15))))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br $l)))
    (call $putc (i32.const 34)))

  (func $putlist (param $a i32) (param $n i32)
    (local $k i32)
    (block $d (loop $l
      (br_if $d (i32.ge_u (local.get $k) (local.get $n)))
      (if (local.get $k) (then (call $putc (i32.const 44))))
      (call $puti (i32.load (i32.add (local.get $a) (i32.shl (local.get $k) (i32.const 2)))))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br $l))))

  (func $close
    (call $puts (i32.const 1056)) (call $putu (global.get $seq))
    (call $puts (i32.const 1088)))

  (func $refuse
    (global.set $o (i32.const 65536))
    (call $puts (i32.const 1120))
    (call $puts (i32.add (i32.const 1472) (i32.shl (i32.ctz (global.get $errs)) (i32.const 5))))
    (if (i32.eqz (global.get $bad))
      (then (call $puts (i32.const 1152)) (call $putu (global.get $seq)))
      (else (call $putc (i32.const 34))))
    (call $puts (i32.const 1184)))

  ;; ================= ops =================
  (func $op_info
    (global.set $o (i32.const 65536))
    (call $puts (i32.const 704))
    (call $puts (i32.const 1216))
    (call $puthex (i32.const 1728))
    (call $puts (i32.const 1408))
    (call $puthex (i32.const 1760))
    (call $close))

  (func $op_step_monolith
    (call $apply_M_and_drive (global.get $w) (global.get $u))
    (call $words_sha (i32.const 14976) (i32.const 160) (i32.const 2688))
    (global.set $o (i32.const 65536))
    (call $puts (i32.const 704))
    (call $puts (i32.const 768)) (call $putlist (i32.const 14976) (i32.const 20))
    (call $puts (i32.const 960)) (call $putlist (i32.const 14976) (i32.const 160))
    (call $puts (i32.const 1024)) (call $puthex (i32.const 2688))
    (call $close))

  (func $op_boundary
    (local $ob i32)
    (local.set $ob (call $obase (global.get $w) (global.get $organ)))
    ;; Ra20 (7 x 20 u16le at ob + 0) * bodyBuf[0..19] (15616) -> msgOutBuf[0..6] (16288)
    (call $matvec (local.get $ob) (i32.const 7) (i32.const 20) (i32.const 15616) (i32.const 16288))
    (global.set $o (i32.const 65536))
    (call $puts (i32.const 704))
    (call $puts (i32.const 864)) (call $putlist (i32.const 16288) (i32.const 7)) (call $putc (i32.const 93))
    (call $close))

  (func $op_step_organ
    (local $ob i32) (local $s0 i32) (local $j i32) (local $addv i32)
    (local.set $ob (call $obase (global.get $w) (global.get $organ)))
    (local.set $s0 (i32.add (i32.const 20) (i32.mul (global.get $organ) (i32.const 12))))
    ;; 1. msgOut = Rb12 (7 x 12 u16le at ob + 448) * organBuf[0..11] (start-of-tick q_a) -> msgOutBuf (16288)
    (call $matvec (i32.add (local.get $ob) (i32.const 448)) (i32.const 7) (i32.const 12) (i32.const 16160) (i32.const 16288))
    ;; 2. M_aa * organBuf via zero-padded fullIn + apply_M_and_drive($w, 0)
    (call $zero_full_in)
    (local.set $j (i32.const 0))
    (loop $sc
      (i32.store (i32.add (i32.const 14336) (i32.shl (i32.add (local.get $s0) (local.get $j)) (i32.const 2)))
        (i32.load (i32.add (i32.const 16160) (i32.shl (local.get $j) (i32.const 2)))))
      (i32.store (i32.add (i32.const 14656) (i32.shl (i32.add (local.get $s0) (local.get $j)) (i32.const 2)))
        (i32.load (i32.add (i32.const 16208) (i32.shl (local.get $j) (i32.const 2)))))
      (local.set $j (i32.add (local.get $j) (i32.const 1)))
      (br_if $sc (i32.lt_u (local.get $j) (i32.const 12))))
    (call $apply_M_and_drive (global.get $w) (i32.const 0))
    ;; 3. Fa12 (12 x 7 u16le at ob + 280) * msgBuf (16256) -> scratch fullIn[0..11], then add to q'_a and p'_a
    (call $matvec (i32.add (local.get $ob) (i32.const 280)) (i32.const 12) (i32.const 7) (i32.const 16256) (i32.const 14336))
    (local.set $j (i32.const 0))
    (loop $up
      (local.set $addv (i32.load (i32.add (i32.const 14336) (i32.shl (local.get $j) (i32.const 2)))))
      (i32.store (i32.add (i32.const 16160) (i32.shl (local.get $j) (i32.const 2)))
        (i32.rem_u
          (i32.add (i32.load (i32.add (i32.const 14976) (i32.shl (i32.add (local.get $s0) (local.get $j)) (i32.const 2))))
                   (local.get $addv))
          (i32.const 65521)))
      (i32.store (i32.add (i32.const 16208) (i32.shl (local.get $j) (i32.const 2)))
        (i32.rem_u
          (i32.add (i32.load (i32.add (i32.const 15296) (i32.shl (i32.add (local.get $s0) (local.get $j)) (i32.const 2))))
                   (local.get $addv))
          (i32.const 65521)))
      (local.set $j (i32.add (local.get $j) (i32.const 1)))
      (br_if $up (i32.lt_u (local.get $j) (i32.const 12))))
    (call $words_sha (i32.const 16160) (i32.const 24) (i32.const 2688))
    (global.set $o (i32.const 65536))
    (call $puts (i32.const 704))
    (call $puts (i32.const 832)) (call $putlist (i32.const 16288) (i32.const 7))
    (call $puts (i32.const 928)) (call $putlist (i32.const 16160) (i32.const 24))
    (call $puts (i32.const 992)) (call $puthex (i32.const 2688))
    (call $close))

  (func $op_step_body
    (local $ob i32) (local $s0 i32) (local $idx i32) (local $s i32) (local $addv i32)
    (local.set $ob (call $obase (global.get $w) (global.get $organ)))
    (local.set $s0 (i32.add (i32.const 20) (i32.mul (global.get $organ) (i32.const 12))))
    ;; 1. Scatter bodyBuf (15616: q_b at +0, p_b at +272) into zero-padded fullIn
    (call $zero_full_in)
    (local.set $idx (i32.const 0))
    (loop $sc
      (local.set $s (select (local.get $idx) (i32.add (local.get $idx) (i32.const 12))
                            (i32.lt_u (local.get $idx) (local.get $s0))))
      (i32.store (i32.add (i32.const 14336) (i32.shl (local.get $s) (i32.const 2)))
        (i32.load (i32.add (i32.const 15616) (i32.shl (local.get $idx) (i32.const 2)))))
      (i32.store (i32.add (i32.const 14656) (i32.shl (local.get $s) (i32.const 2)))
        (i32.load (i32.add (i32.const 15888) (i32.shl (local.get $idx) (i32.const 2)))))
      (local.set $idx (i32.add (local.get $idx) (i32.const 1)))
      (br_if $sc (i32.lt_u (local.get $idx) (i32.const 68))))
    ;; 2. Advance with drive $u on corner 0
    (call $apply_M_and_drive (global.get $w) (global.get $u))
    ;; 3. Gather S_b back into bodyBuf
    (local.set $idx (i32.const 0))
    (loop $ga
      (local.set $s (select (local.get $idx) (i32.add (local.get $idx) (i32.const 12))
                            (i32.lt_u (local.get $idx) (local.get $s0))))
      (i32.store (i32.add (i32.const 15616) (i32.shl (local.get $idx) (i32.const 2)))
        (i32.load (i32.add (i32.const 14976) (i32.shl (local.get $s) (i32.const 2)))))
      (i32.store (i32.add (i32.const 15888) (i32.shl (local.get $idx) (i32.const 2)))
        (i32.load (i32.add (i32.const 15296) (i32.shl (local.get $s) (i32.const 2)))))
      (local.set $idx (i32.add (local.get $idx) (i32.const 1)))
      (br_if $ga (i32.lt_u (local.get $idx) (i32.const 68))))
    ;; 4. Fb20 (20 x 7 u16le at ob + 616) * msgBuf (16256) -> scratch fullIn[0..19], add to corners q_b[0..19] & p_b[0..19]
    (call $matvec (i32.add (local.get $ob) (i32.const 616)) (i32.const 20) (i32.const 7) (i32.const 16256) (i32.const 14336))
    (local.set $idx (i32.const 0))
    (loop $up
      (local.set $addv (i32.load (i32.add (i32.const 14336) (i32.shl (local.get $idx) (i32.const 2)))))
      (i32.store (i32.add (i32.const 15616) (i32.shl (local.get $idx) (i32.const 2)))
        (i32.rem_u
          (i32.add (i32.load (i32.add (i32.const 15616) (i32.shl (local.get $idx) (i32.const 2))))
                   (local.get $addv))
          (i32.const 65521)))
      (i32.store (i32.add (i32.const 15888) (i32.shl (local.get $idx) (i32.const 2)))
        (i32.rem_u
          (i32.add (i32.load (i32.add (i32.const 15888) (i32.shl (local.get $idx) (i32.const 2))))
                   (local.get $addv))
          (i32.const 65521)))
      (local.set $idx (i32.add (local.get $idx) (i32.const 1)))
      (br_if $up (i32.lt_u (local.get $idx) (i32.const 20))))
    (call $words_sha (i32.const 15616) (i32.const 136) (i32.const 2688))
    (global.set $o (i32.const 65536))
    (call $puts (i32.const 704))
    (call $puts (i32.const 736)) (call $puthex (i32.const 2688))
    (call $puts (i32.const 800)) (call $putlist (i32.const 15616) (i32.const 20))
    (call $puts (i32.const 896)) (call $putlist (i32.const 15616) (i32.const 136)) (call $putc (i32.const 93))
    (call $close))

  ;; ================= ABI =================
  (func (export "mv_abi_version") (result i32) (i32.const 1))

  (func (export "mv_alloc") (param $len i32) (result i32)
    (if (result i32) (i32.le_u (local.get $len) (i32.const 16384))
      (then (i32.const 16384))
      (else (i32.const 0))))

  ;; form / op:
  ;;   1 hive.info          {}
  ;;   2 hive.step_monolith {input, state, wiring}
  ;;   3 hive.boundary      {bodyState, edgeOrgan, wiring}
  ;;   4 hive.step_organ    {input, msgIn, organ, organState, wiring}
  ;;   5 hive.step_body     {bodyState, edgeOrgan, input, msgFromEdge, wiring}
  (func (export "mv_run") (param $ptr i32) (param $len i32) (result i64)
    (local $form i32) (local $op i32)
    (global.set $errs (i32.const 0))
    (global.set $bad (i32.const 0))
    (global.set $failcode (i32.const 1))
    (global.set $seq (i64.const 0))
    (global.set $o (i32.const 65536))
    (global.set $w (i32.const 0))
    (global.set $organ (i32.const 0))
    (global.set $u (i32.const 0))
    (call $sha_consts)
    (if (i32.or (i32.ne (local.get $ptr) (i32.const 16384)) (i32.gt_u (local.get $len) (i32.const 16384)))
      (then (call $fail))
      (else
        (global.set $p (local.get $ptr))
        (global.set $end (i32.add (local.get $ptr) (local.get $len)))
        (call $lit (i32.const 64))
        (global.set $failcode (i32.const 3))
        (if (i32.eq (call $peek) (i32.const 125))
          (then (local.set $form (i32.const 1)))
          (else
            (if (call $try (i32.const 128))
              (then
                (global.set $u (call $word))
                (if (call $try (i32.const 352))
                  (then
                    (local.set $form (i32.const 2))
                    (call $exact_words (i32.const 14336) (i32.const 160))
                    (call $lit (i32.const 384))
                    (call $parse_wiring))
                  (else
                    (local.set $form (i32.const 4))
                    (call $lit (i32.const 256))
                    (call $exact_words (i32.const 16256) (i32.const 7))
                    (call $lit (i32.const 288))
                    (global.set $organ (call $organ_idx))
                    (call $lit (i32.const 320))
                    (call $exact_words (i32.const 16160) (i32.const 24))
                    (call $lit (i32.const 384))
                    (call $parse_wiring))))
              (else
                (call $lit (i32.const 96))
                (call $exact_words (i32.const 15616) (i32.const 136))
                (call $lit (i32.const 160))
                (global.set $organ (call $organ_idx))
                (if (call $try (i32.const 384))
                  (then
                    (local.set $form (i32.const 3))
                    (call $parse_wiring))
                  (else
                    (local.set $form (i32.const 5))
                    (call $lit (i32.const 192))
                    (global.set $u (call $word))
                    (call $lit (i32.const 224))
                    (call $exact_words (i32.const 16256) (i32.const 7))
                    (call $lit (i32.const 384))
                    (call $parse_wiring)))))))
        (if (i32.eqz (global.get $bad)) (then (global.set $failcode (i32.const 1))))
        (if (i32.eqz (global.get $bad))
          (then
            (call $lit (i32.const 416))
            (if (call $try (i32.const 448)) (then (local.set $op (i32.const 1)))
              (else (if (call $try (i32.const 480)) (then (local.set $op (i32.const 2)))
                (else (if (call $try (i32.const 512)) (then (local.set $op (i32.const 3)))
                  (else (if (call $try (i32.const 544)) (then (local.set $op (i32.const 4)))
                    (else (if (call $try (i32.const 576)) (then (local.set $op (i32.const 5)))
                      (else (if (i32.eqz (global.get $bad)) (then (call $flag (i32.const 2)) (call $skip_name)))))))))))))
            (call $lit (i32.const 608))
            (global.set $seq (call $uint))
            (call $eat (i32.const 125))
            (if (i32.ne (global.get $p) (global.get $end)) (then (call $fail)))))
        (if (i32.eqz (global.get $bad))
          (then
            (if (i32.and (i32.ne (local.get $op) (i32.const 0)) (i32.ne (local.get $op) (local.get $form)))
              (then (call $flag (i32.const 3))))))
        (if (i32.eqz (global.get $errs))
          (then
            (if (i32.eq (local.get $op) (i32.const 1)) (then (call $op_info)))
            (if (i32.eq (local.get $op) (i32.const 2)) (then (call $op_step_monolith)))
            (if (i32.eq (local.get $op) (i32.const 3)) (then (call $op_boundary)))
            (if (i32.eq (local.get $op) (i32.const 4)) (then (call $op_step_organ)))
            (if (i32.eq (local.get $op) (i32.const 5)) (then (call $op_step_body)))))))
    (if (global.get $errs) (then (call $refuse)))
    (i64.or
      (i64.shl (i64.extend_i32_u (i32.sub (global.get $o) (i32.const 65536))) (i64.const 32))
      (i64.const 65536))))
