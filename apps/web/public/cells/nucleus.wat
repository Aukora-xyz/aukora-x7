;; nucleus.wat : Auma's deterministic nucleus. The reflex machine of the Kyber lab (2026-11-12, lane V1,
;; reflex_machine.wat sha256 0e83f2f6334c5c696c987ade995f22c5394e63f465d3dc73250de4f4418a2646), ported into her
;; pinned cells. One fixed sealed cell; a reflex is DATA (a decision table or a small int8 network) and its
;; escalation definition is part of that data. It holds no authority: it computes and returns. docs/auma/nucleus.md.
;; Microverse ABI v1 guest. i32 and i64 only. No imports. One memory of 16 pages, fixed.
;; Kinds: table, net, pnet (packed net); their reading and evaluation are the lab's v1, unchanged.
;; Changed from the lab, the request and answer words only (the lab's op names were its own):
;;   reflex.run    input {"input":case,"reflex":R}  (case: [v0,..] or the mixed-radix index)
;;                 result {"decision":k,"escalate":0|1,"reflex":"<sha256>","row":idx}
;;                 escalate: k is an escalation under R's own definition (new; the lab's run did not say)
;;   reflex.diff   input {"after":R,"before":R,"cap":L,"domain":[sizes]}  (the lab's reflex.atlas; old = before)
;;                 the stated domain must equal both reflexes' sizes, else DOMAIN_MISMATCH (new)
;;                 result: the lab's atlas fields, with "old"/"new" digests named "before"/"after"
;;   reflex.census input {"reflex":R}  result {"cases":D,"census":[[k,n],..],"invalid":I,"reflex":"<sha256>"}
;;   reflex.digest input {"reflex":R}  result {"bytes":N,"cases":D,"escalate":"<sha256>","reflex":"<sha256>"} (new)
;;
;; Storage map (bytes):
;;   64..1887      text literals, NUL-terminated, one per 32-byte slot; refusal code c at 1632 + 32*c
;;   2016 2880 2912 3008 3040  nucleus text literals;  3904..3967 the stated domain of reflex.diff (16 x i32)
;;   2048..2303    SHA-256 round constants K (written by $sha_consts)
;;   2304..2335    SHA-256 state H;  2336..2399 block;  2400..2655 message schedule W
;;   2688 2720 2752  digests: reflex in slot A, reflex in slot B, checksum of the changed list
;;   2816..2879    decimal digit scratch
;;   2944..3007    reflex.run case values (16 x i32)
;;   3072..3327    activations X (64 x i32);  3328..3583 activations Y
;;   3840..3903    case values while evaluating (16 x i32)
;;   4096..8191    escalation set of slot A, one bit per code 0..32767;  8192..12287 the same for slot B
;;   2784..2815    digest of slot A's escalation definition;  3584..3839 and 1888..2015 v1 text literals
;;   v1 slot fields: +448 escalate form (1 list, 2 masks), +452 if_clear, +456 if_set, +460 start, +464 end,
;;                 +468 list: largest code + 1 (0 when empty)
;;   65536         slot A (run/census data, atlas old);  131072 slot B (atlas new; census counts, u16 per code)
;;                 slot: +0 kind (1 table, 2 net), +4 nvars, +8 D, +12 K, +16 nlayers, +20 start, +24 end,
;;                 +28 shape fault, +32 sizes[16], +96 feed[16], +160 nfeed, +164 W count, +168 rows in all,
;;                 +172 non-zero count, +176 out mode (0 onehot, 1 flags), +180 last layer rows,
;;                 +192 layer l at +192+32l: rows, cols, shift, first global row,
;;                 +512 bias[512] i32, +2560 rowstart[513] i32, +8192 non-zero W entries[4096] i32 as
;;                 (col << 16) | (w & 0xffff), +32768 table[16384] u16
;;   196608        outcomes of slot A (u16 x 16384);  229376 outcomes of slot B; 65535 = no valid answer
;;   262144..524287  request (mv_alloc)
;;   524288..1048575 response
(module
  (memory (export "memory") 16 16)

  (global $p (mut i32) (i32.const 0))
  (global $end (mut i32) (i32.const 0))
  (global $err (mut i32) (i32.const 0))       ;; 0 none; 1 MALFORMED 2 OP_UNKNOWN 3 LIMIT 4 SHAPE 5 DOMAIN_MISMATCH 6 CASE_RANGE 7 NO_VALID_ANSWER
  (global $withseq (mut i32) (i32.const 0))
  (global $seq (mut i64) (i64.const 0))
  (global $o (mut i32) (i32.const 524288))
  (global $form (mut i32) (i32.const 0))      ;; 1 run, 2 one reflex (census, digest), 3 diff (from the input shape)
  (global $op (mut i32) (i32.const 0))        ;; 1 run, 2 census, 3 diff, 4 digest (from the op word)
  (global $dn (mut i32) (i32.const 0))        ;; reflex.diff: number of variables in the stated domain
  (global $casemode (mut i32) (i32.const 0))  ;; 1 values, 2 index
  (global $ncase (mut i32) (i32.const 0))
  (global $pidx (mut i32) (i32.const 0))
  (global $cap (mut i32) (i32.const 0))
  (global $fill (mut i32) (i32.const 0))
  (global $len (mut i64) (i64.const 0))

  ;; ---- request literals ----
  (data (i32.const 64) "{\22abi\22:1,\22input\22:{\22")
  (data (i32.const 96) "after\22:")
  (data (i32.const 128) "input\22:")
  (data (i32.const 160) "reflex\22:")
  (data (i32.const 192) ",\22domain\22:[")
  (data (i32.const 224) ",\22before\22:")
  (data (i32.const 256) ",\22cap\22:")
  (data (i32.const 288) ",\22reflex\22:")
  (data (i32.const 320) "},\22op\22:\22")
  (data (i32.const 352) "reflex.run\22")
  (data (i32.const 384) "reflex.census\22")
  (data (i32.const 416) "reflex.diff\22")
  (data (i32.const 2016) "reflex.digest\22")
  (data (i32.const 448) ",\22seq\22:")
  (data (i32.const 480) "{\22")
  (data (i32.const 512) "feed\22:[")
  (data (i32.const 544) ",\22kind\22:\22")
  (data (i32.const 576) "net\22,\22layers\22:[")
  (data (i32.const 608) "pnet\22,\22layers\22:[")
  (data (i32.const 640) ",\22out\22:\22")
  (data (i32.const 672) "onehot\22")
  (data (i32.const 704) "flags\22")
  (data (i32.const 736) ",\22sizes\22:[")
  (data (i32.const 768) "kind\22:\22table\22,\22outcomes\22:")
  (data (i32.const 800) ",\22table\22:[")
  (data (i32.const 832) "{\22W\22:[")
  (data (i32.const 864) ",\22b\22:[")
  (data (i32.const 896) ",\22shift\22:")
  (data (i32.const 928) "{\22cols\22:")
  (data (i32.const 960) ",\22nz\22:[")
  (data (i32.const 992) ",\22rows\22:")
  ;; ---- response literals ----
  (data (i32.const 1024) "{\22abi\22:1,\22result\22:{")
  (data (i32.const 1056) "\22cases\22:")
  (data (i32.const 1088) ",\22changed\22:")
  (data (i32.const 1120) ",\22changes\22:[")
  (data (i32.const 1152) "],\22checksum\22:")
  (data (i32.const 1216) ",\22invalid\22:")
  (data (i32.const 1312) ",\22truncated\22:")
  (data (i32.const 1344) ",\22unchanged\22:")
  (data (i32.const 1376) ",\22census\22:[")
  (data (i32.const 1536) "},\22seq\22:")
  (data (i32.const 1568) ",\22status\22:\22ok\22}")
  (data (i32.const 1600) "{\22abi\22:1,\22code\22:\22")
  (data (i32.const 1632) ",\22status\22:\22refused\22}")
  ;; ---- refusal codes: address 1632 + 32 * code ----
  (data (i32.const 1664) "MALFORMED")
  (data (i32.const 1696) "OP_UNKNOWN")
  (data (i32.const 1728) "LIMIT")
  (data (i32.const 1760) "SHAPE")
  (data (i32.const 1792) "DOMAIN_MISMATCH")
  (data (i32.const 1824) "CASE_RANGE")
  (data (i32.const 1856) "NO_VALID_ANSWER")
  ;; v1 literals
  (data (i32.const 1888) "escalate\22:")
  (data (i32.const 1920) "if_clear\22:")
  (data (i32.const 1952) ",\22if_set\22:")
  (data (i32.const 1984) ",\22")
  (data (i32.const 3584) "\22became_invalid\22:[")
  (data (i32.const 3616) "],\22became_invalid_count\22:")
  (data (i32.const 3648) ",\22escalate\22:")
  (data (i32.const 3680) ",\22escalate_differs\22:")
  (data (i32.const 3712) ",\22escalations_removed\22:")
  (data (i32.const 3744) ",\22escalations_removed_list\22:[")
  ;; nucleus literals (answers); ,"reflex": and ,"before": reuse the request literals at 288 and 224
  (data (i32.const 2880) "\22decision\22:")
  (data (i32.const 2912) ",\22row\22:")
  (data (i32.const 3008) "\22bytes\22:")
  (data (i32.const 3040) "\22after\22:")

  ;; ================= reading =================
  (func $seterr (param $c i32)
    (if (i32.eqz (global.get $err)) (then (global.set $err (local.get $c)))))

  (func $peek (result i32)
    (if (result i32) (i32.lt_u (global.get $p) (global.get $end))
      (then (i32.load8_u (global.get $p)))
      (else (i32.const 0))))

  (func $eat (param $c i32)
    (if (i32.eq (call $peek) (local.get $c))
      (then (global.set $p (i32.add (global.get $p) (i32.const 1))))
      (else (call $seterr (i32.const 1)))))

  ;; Match the NUL-terminated literal at $a. On a full match advance and return 1; else return 0, cursor unmoved.
  (func $try (param $a i32) (result i32)
    (local $q i32) (local $c i32)
    (local.set $q (global.get $p))
    (block $done
      (loop $next
        (local.set $c (i32.load8_u (local.get $a)))
        (br_if $done (i32.eqz (local.get $c)))
        (if (i32.ge_u (local.get $q) (global.get $end)) (then (return (i32.const 0))))
        (if (i32.ne (i32.load8_u (local.get $q)) (local.get $c)) (then (return (i32.const 0))))
        (local.set $a (i32.add (local.get $a) (i32.const 1)))
        (local.set $q (i32.add (local.get $q) (i32.const 1)))
        (br $next)))
    (global.set $p (local.get $q))
    (i32.const 1))

  (func $lit (param $a i32)
    (if (i32.eqz (call $try (local.get $a))) (then (call $seterr (i32.const 1)))))

  ;; Canonical integer: optional '-', no leading zero, no -0, |v| <= 2^53 - 1.
  (func $int (result i64)
    (local $c i32) (local $v i64) (local $k i32) (local $neg i32)
    (if (global.get $err) (then (return (i64.const 0))))
    (if (i32.eq (call $peek) (i32.const 45))
      (then (local.set $neg (i32.const 1)) (global.set $p (i32.add (global.get $p) (i32.const 1)))))
    (local.set $c (call $peek))
    (if (i32.gt_u (i32.sub (local.get $c) (i32.const 48)) (i32.const 9))
      (then (call $seterr (i32.const 1)) (return (i64.const 0))))
    (if (i32.eq (local.get $c) (i32.const 48))
      (then
        (global.set $p (i32.add (global.get $p) (i32.const 1)))
        (if (i32.or (local.get $neg) (i32.le_u (i32.sub (call $peek) (i32.const 48)) (i32.const 9)))
          (then (call $seterr (i32.const 1))))
        (return (i64.const 0))))
    (block $done
      (loop $next
        (local.set $c (call $peek))
        (br_if $done (i32.gt_u (i32.sub (local.get $c) (i32.const 48)) (i32.const 9)))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (if (i32.gt_u (local.get $k) (i32.const 16)) (then (call $seterr (i32.const 1)) (return (i64.const 0))))
        (local.set $v (i64.add (i64.mul (local.get $v) (i64.const 10))
                               (i64.extend_i32_u (i32.sub (local.get $c) (i32.const 48)))))
        (global.set $p (i32.add (global.get $p) (i32.const 1)))
        (br $next)))
    (if (i64.gt_u (local.get $v) (i64.const 9007199254740991)) (then (call $seterr (i32.const 1)) (return (i64.const 0))))
    (if (result i64) (local.get $neg)
      (then (i64.sub (i64.const 0) (local.get $v)))
      (else (local.get $v))))

  ;; An integer in lo..hi (checked as i64), else refusal $code.
  (func $intr (param $lo i64) (param $hi i64) (param $code i32) (result i32)
    (local $v i64)
    (local.set $v (call $int))
    (if (global.get $err) (then (return (i32.const 0))))
    (if (i32.or (i64.lt_s (local.get $v) (local.get $lo)) (i64.gt_s (local.get $v) (local.get $hi)))
      (then (call $seterr (local.get $code)) (return (i32.const 0))))
    (i32.wrap_i64 (local.get $v)))

  ;; After a list element: ',' -> 1 (another follows); ']' -> 0 (list closed); else MALFORMED.
  (func $more (result i32)
    (local $c i32)
    (if (global.get $err) (then (return (i32.const 0))))
    (local.set $c (call $peek))
    (if (i32.eq (local.get $c) (i32.const 44))
      (then (global.set $p (i32.add (global.get $p) (i32.const 1))) (return (i32.const 1))))
    (if (i32.eq (local.get $c) (i32.const 93))
      (then (global.set $p (i32.add (global.get $p) (i32.const 1))) (return (i32.const 0))))
    (call $seterr (i32.const 1))
    (i32.const 0))

  ;; Just after '[': consume ']' and return 1 when the list is empty.
  (func $empty (result i32)
    (if (i32.eq (call $peek) (i32.const 93))
      (then (global.set $p (i32.add (global.get $p) (i32.const 1))) (return (i32.const 1))))
    (i32.const 0))

  (func $shape (param $s i32) (i32.store offset=28 (local.get $s) (i32.const 1)))

  ;; ,"sizes":[..]  -> nvars, D
  (func $sizes (param $s i32)
    (local $n i32) (local $v i32) (local $d i32)
    (call $lit (i32.const 736))
    (local.set $d (i32.const 1))
    (if (call $empty) (then (call $seterr (i32.const 3)) (return)))
    (block $done (loop $next
      (br_if $done (global.get $err))
      (local.set $v (call $intr (i64.const 2) (i64.const 64) (i32.const 3)))
      (br_if $done (global.get $err))
      (if (i32.ge_u (local.get $n) (i32.const 16)) (then (call $seterr (i32.const 3)) (br $done)))
      (i32.store offset=32 (i32.add (local.get $s) (i32.shl (local.get $n) (i32.const 2))) (local.get $v))
      (local.set $n (i32.add (local.get $n) (i32.const 1)))
      (local.set $d (i32.mul (local.get $d) (local.get $v)))
      (if (i32.gt_u (local.get $d) (i32.const 16384)) (then (call $seterr (i32.const 3)) (br $done)))
      (br_if $next (call $more))))
    (i32.store offset=4 (local.get $s) (local.get $n))
    (i32.store offset=8 (local.get $s) (local.get $d)))

  ;; layers of a `net` (after "net","layers":[ )
  (func $vlayers (param $s i32)
    (local $l i32) (local $rows i32) (local $cols i32) (local $n i32) (local $v i32) (local $tr i32) (local $nz i32)
    (local $tw i32) (local $bn i32) (local $meta i32) (local $rb i32)
    (if (call $empty) (then (call $seterr (i32.const 1)) (return)))
    (block $ldone (loop $lnext
      (br_if $ldone (global.get $err))
      (if (i32.ge_u (local.get $l) (i32.const 8)) (then (call $seterr (i32.const 3)) (br $ldone)))
      (call $lit (i32.const 832))
      (local.set $rb (local.get $tr))
      (local.set $rows (i32.const 0))
      (local.set $cols (i32.const -1))
      (if (call $empty) (then (call $seterr (i32.const 1)) (br $ldone)))
      (block $rdone (loop $rnext
        (br_if $rdone (global.get $err))
        (if (i32.ge_u (local.get $rows) (i32.const 64)) (then (call $seterr (i32.const 3)) (br $rdone)))
        (call $eat (i32.const 91))
        (i32.store offset=2560 (i32.add (local.get $s) (i32.shl (local.get $tr) (i32.const 2))) (local.get $nz))
        (local.set $n (i32.const 0))
        (if (call $empty) (then (call $seterr (i32.const 1)) (br $rdone)))
        (block $vdone (loop $vnext
          (br_if $vdone (global.get $err))
          (local.set $v (call $intr (i64.const -128) (i64.const 127) (i32.const 1)))
          (br_if $vdone (global.get $err))
          (if (i32.ge_u (local.get $n) (i32.const 64)) (then (call $seterr (i32.const 3)) (br $vdone)))
          (local.set $tw (i32.add (local.get $tw) (i32.const 1)))
          (if (i32.gt_u (local.get $tw) (i32.const 4096)) (then (call $seterr (i32.const 3)) (br $vdone)))
          (if (local.get $v)
            (then
              (i32.store offset=8192 (i32.add (local.get $s) (i32.shl (local.get $nz) (i32.const 2)))
                (i32.or (i32.shl (local.get $n) (i32.const 16)) (i32.and (local.get $v) (i32.const 65535))))
              (local.set $nz (i32.add (local.get $nz) (i32.const 1)))))
          (local.set $n (i32.add (local.get $n) (i32.const 1)))
          (br_if $vnext (call $more))))
        (if (i32.lt_s (local.get $cols) (i32.const 0))
          (then (local.set $cols (local.get $n)))
          (else (if (i32.ne (local.get $n) (local.get $cols)) (then (call $shape (local.get $s))))))
        (local.set $rows (i32.add (local.get $rows) (i32.const 1)))
        (local.set $tr (i32.add (local.get $tr) (i32.const 1)))
        (br_if $rnext (call $more))))
      (br_if $ldone (global.get $err))
      (i32.store offset=2560 (i32.add (local.get $s) (i32.shl (local.get $tr) (i32.const 2))) (local.get $nz))
      (call $lit (i32.const 864))
      (local.set $bn (i32.const 0))
      (if (i32.eqz (call $empty))
        (then
          (block $bdone (loop $bnext
            (br_if $bdone (global.get $err))
            (local.set $v (call $intr (i64.const -128) (i64.const 127) (i32.const 1)))
            (br_if $bdone (global.get $err))
            (if (i32.ge_u (local.get $bn) (i32.const 64)) (then (call $seterr (i32.const 3)) (br $bdone)))
            (if (i32.lt_u (local.get $bn) (local.get $rows))
              (then (i32.store offset=512 (i32.add (local.get $s) (i32.shl (i32.add (local.get $rb) (local.get $bn)) (i32.const 2)))
                      (local.get $v))))
            (local.set $bn (i32.add (local.get $bn) (i32.const 1)))
            (br_if $bnext (call $more))))))
      (if (i32.ne (local.get $bn) (local.get $rows)) (then (call $shape (local.get $s))))
      (call $lit (i32.const 896))
      (local.set $v (call $intr (i64.const 0) (i64.const 15) (i32.const 3)))
      (call $eat (i32.const 125))
      (br_if $ldone (global.get $err))
      (local.set $meta (i32.add (i32.add (local.get $s) (i32.const 192)) (i32.shl (local.get $l) (i32.const 5))))
      (i32.store (local.get $meta) (local.get $rows))
      (i32.store offset=4 (local.get $meta) (local.get $cols))
      (i32.store offset=8 (local.get $meta) (local.get $v))
      (i32.store offset=12 (local.get $meta) (local.get $rb))
      (local.set $l (i32.add (local.get $l) (i32.const 1)))
      (br_if $lnext (call $more))))
    (i32.store offset=16 (local.get $s) (local.get $l))
    (i32.store offset=164 (local.get $s) (local.get $tw))
    (i32.store offset=168 (local.get $s) (local.get $tr))
    (i32.store offset=172 (local.get $s) (local.get $nz))
    (i32.store offset=180 (local.get $s) (local.get $rows)))

  ;; layers of a `pnet` (after "pnet","layers":[ )
  (func $players (param $s i32)
    (local $l i32) (local $rows i32) (local $cols i32) (local $v i32) (local $e i64) (local $pl i64) (local $prev i64)
    (local $pos i32) (local $row i32) (local $col i32) (local $cur i32) (local $tr i32) (local $nz i32) (local $tw i32)
    (local $rb i32) (local $k i32) (local $sh i32) (local $meta i32)
    (if (call $empty) (then (call $seterr (i32.const 1)) (return)))
    (block $ldone (loop $lnext
      (br_if $ldone (global.get $err))
      (if (i32.ge_u (local.get $l) (i32.const 8)) (then (call $seterr (i32.const 3)) (br $ldone)))
      (call $lit (i32.const 928))
      (local.set $cols (call $intr (i64.const 1) (i64.const 64) (i32.const 3)))
      (call $lit (i32.const 960))
      (br_if $ldone (global.get $err))
      (local.set $rb (local.get $tr))
      (local.set $k (i32.const 0))
      (loop $zb
        (i32.store offset=512 (i32.add (local.get $s) (i32.shl (i32.add (local.get $rb) (local.get $k)) (i32.const 2))) (i32.const 0))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br_if $zb (i32.lt_u (local.get $k) (i32.const 64))))
      (local.set $cur (i32.const -1))
      (local.set $prev (i64.const -1))
      (if (i32.eqz (call $empty))
        (then
          (block $edone (loop $enext
            (br_if $edone (global.get $err))
            (local.set $e (call $int))
            (br_if $edone (global.get $err))
            (if (i64.lt_s (local.get $e) (i64.const 0)) (then (call $seterr (i32.const 1)) (br $edone)))
            (local.set $pl (i64.shr_s (local.get $e) (i64.const 8)))
            (local.set $v (i32.sub (i32.wrap_i64 (i64.and (local.get $e) (i64.const 255))) (i32.const 128)))
            (if (i32.or (i32.eqz (local.get $v)) (i64.le_s (local.get $pl) (local.get $prev)))
              (then (call $seterr (i32.const 1)) (br $edone)))
            (local.set $prev (local.get $pl))
            (if (i64.ge_s (local.get $pl) (i64.extend_i32_u (i32.mul (i32.const 64) (i32.add (local.get $cols) (i32.const 1)))))
              (then (call $seterr (i32.const 3)) (br $edone)))
            (local.set $pos (i32.wrap_i64 (local.get $pl)))
