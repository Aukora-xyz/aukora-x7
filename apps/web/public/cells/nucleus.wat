        (block $d5 (loop $l5
          (br_if $d5 (i32.ge_u (local.get $e) (local.get $ee)))
          (local.set $ent (i32.load offset=8192 (i32.add (local.get $s) (i32.shl (local.get $e) (i32.const 2)))))
          (local.set $acc (i32.add (local.get $acc)
            (i32.mul (i32.shr_s (i32.shl (local.get $ent) (i32.const 16)) (i32.const 16))
                     (i32.load (i32.add (local.get $x) (i32.shl (i32.shr_u (local.get $ent) (i32.const 16)) (i32.const 2)))))))
          (local.set $e (i32.add (local.get $e) (i32.const 1)))
          (br $l5)))
        (local.set $acc (i32.shr_s (local.get $acc) (local.get $sh)))
        (if (i32.lt_s (local.get $acc) (i32.const 0)) (then (local.set $acc (i32.const 0))))
        (if (i32.gt_s (local.get $acc) (i32.const 127)) (then (local.set $acc (i32.const 127))))
        (i32.store (i32.add (local.get $y) (i32.shl (local.get $r) (i32.const 2))) (local.get $acc))
        (local.set $g (i32.add (local.get $g) (i32.const 1)))
        (local.set $r (i32.add (local.get $r) (i32.const 1)))
        (br $l4)))
      (local.set $t (local.get $x))
      (local.set $x (local.get $y))
      (local.set $y (local.get $t))
      (local.set $l (i32.add (local.get $l) (i32.const 1)))
      (br $l3)))
    (local.set $rows (i32.load offset=180 (local.get $s)))
    (local.set $j (i32.const 0))
    (if (i32.eqz (i32.load offset=176 (local.get $s)))
      (then
        (block $d6 (loop $l6
          (br_if $d6 (i32.ge_u (local.get $j) (local.get $rows)))
          (local.set $v (i32.load (i32.add (local.get $x) (i32.shl (local.get $j) (i32.const 2)))))
          (if (i32.eq (local.get $v) (i32.const 127))
            (then (local.set $c127 (i32.add (local.get $c127) (i32.const 1))) (local.set $code (local.get $j))))
          (if (local.get $v) (then (local.set $cnz (i32.add (local.get $cnz) (i32.const 1)))))
          (local.set $j (i32.add (local.get $j) (i32.const 1)))
          (br $l6)))
        (if (i32.and (i32.eq (local.get $c127) (i32.const 1)) (i32.eq (local.get $cnz) (i32.const 1)))
          (then (return (local.get $code))))
        (return (i32.const 65535))))
    (block $d7 (loop $l7
      (br_if $d7 (i32.ge_u (local.get $j) (local.get $rows)))
      (local.set $v (i32.load (i32.add (local.get $x) (i32.shl (local.get $j) (i32.const 2)))))
      (if (i32.eq (local.get $v) (i32.const 127))
        (then (local.set $code (i32.or (local.get $code) (i32.shl (i32.const 1) (local.get $j)))))
        (else (if (local.get $v) (then (return (i32.const 65535))))))
      (local.set $j (i32.add (local.get $j) (i32.const 1)))
      (br $l7)))
    (local.get $code))

  ;; outcome of every case, in order, into $dst (u16 each)
  (func $outcomes (param $s i32) (param $dst i32)
    (local $i i32) (local $d i32)
    (local.set $d (i32.load offset=8 (local.get $s)))
    (block $done (loop $next
      (br_if $done (i32.ge_u (local.get $i) (local.get $d)))
      (i32.store16 (i32.add (local.get $dst) (i32.shl (local.get $i) (i32.const 1))) (call $eval (local.get $s) (local.get $i)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $next))))

  ;; ================= SHA-256 =================
  (func $sha_consts
    (i32.store offset=2048 (i32.const 0) (i32.const 0x428a2f98)) (i32.store offset=2052 (i32.const 0) (i32.const 0x71374491))
    (i32.store offset=2056 (i32.const 0) (i32.const 0xb5c0fbcf)) (i32.store offset=2060 (i32.const 0) (i32.const 0xe9b5dba5))
    (i32.store offset=2064 (i32.const 0) (i32.const 0x3956c25b)) (i32.store offset=2068 (i32.const 0) (i32.const 0x59f111f1))
    (i32.store offset=2072 (i32.const 0) (i32.const 0x923f82a4)) (i32.store offset=2076 (i32.const 0) (i32.const 0xab1c5ed5))
    (i32.store offset=2080 (i32.const 0) (i32.const 0xd807aa98)) (i32.store offset=2084 (i32.const 0) (i32.const 0x12835b01))
    (i32.store offset=2088 (i32.const 0) (i32.const 0x243185be)) (i32.store offset=2092 (i32.const 0) (i32.const 0x550c7dc3))
    (i32.store offset=2096 (i32.const 0) (i32.const 0x72be5d74)) (i32.store offset=2100 (i32.const 0) (i32.const 0x80deb1fe))
    (i32.store offset=2104 (i32.const 0) (i32.const 0x9bdc06a7)) (i32.store offset=2108 (i32.const 0) (i32.const 0xc19bf174))
    (i32.store offset=2112 (i32.const 0) (i32.const 0xe49b69c1)) (i32.store offset=2116 (i32.const 0) (i32.const 0xefbe4786))
    (i32.store offset=2120 (i32.const 0) (i32.const 0x0fc19dc6)) (i32.store offset=2124 (i32.const 0) (i32.const 0x240ca1cc))
    (i32.store offset=2128 (i32.const 0) (i32.const 0x2de92c6f)) (i32.store offset=2132 (i32.const 0) (i32.const 0x4a7484aa))
    (i32.store offset=2136 (i32.const 0) (i32.const 0x5cb0a9dc)) (i32.store offset=2140 (i32.const 0) (i32.const 0x76f988da))
    (i32.store offset=2144 (i32.const 0) (i32.const 0x983e5152)) (i32.store offset=2148 (i32.const 0) (i32.const 0xa831c66d))
    (i32.store offset=2152 (i32.const 0) (i32.const 0xb00327c8)) (i32.store offset=2156 (i32.const 0) (i32.const 0xbf597fc7))
    (i32.store offset=2160 (i32.const 0) (i32.const 0xc6e00bf3)) (i32.store offset=2164 (i32.const 0) (i32.const 0xd5a79147))
    (i32.store offset=2168 (i32.const 0) (i32.const 0x06ca6351)) (i32.store offset=2172 (i32.const 0) (i32.const 0x14292967))
    (i32.store offset=2176 (i32.const 0) (i32.const 0x27b70a85)) (i32.store offset=2180 (i32.const 0) (i32.const 0x2e1b2138))
    (i32.store offset=2184 (i32.const 0) (i32.const 0x4d2c6dfc)) (i32.store offset=2188 (i32.const 0) (i32.const 0x53380d13))
    (i32.store offset=2192 (i32.const 0) (i32.const 0x650a7354)) (i32.store offset=2196 (i32.const 0) (i32.const 0x766a0abb))
    (i32.store offset=2200 (i32.const 0) (i32.const 0x81c2c92e)) (i32.store offset=2204 (i32.const 0) (i32.const 0x92722c85))
    (i32.store offset=2208 (i32.const 0) (i32.const 0xa2bfe8a1)) (i32.store offset=2212 (i32.const 0) (i32.const 0xa81a664b))
    (i32.store offset=2216 (i32.const 0) (i32.const 0xc24b8b70)) (i32.store offset=2220 (i32.const 0) (i32.const 0xc76c51a3))
    (i32.store offset=2224 (i32.const 0) (i32.const 0xd192e819)) (i32.store offset=2228 (i32.const 0) (i32.const 0xd6990624))
    (i32.store offset=2232 (i32.const 0) (i32.const 0xf40e3585)) (i32.store offset=2236 (i32.const 0) (i32.const 0x106aa070))
    (i32.store offset=2240 (i32.const 0) (i32.const 0x19a4c116)) (i32.store offset=2244 (i32.const 0) (i32.const 0x1e376c08))
    (i32.store offset=2248 (i32.const 0) (i32.const 0x2748774c)) (i32.store offset=2252 (i32.const 0) (i32.const 0x34b0bcb5))
    (i32.store offset=2256 (i32.const 0) (i32.const 0x391c0cb3)) (i32.store offset=2260 (i32.const 0) (i32.const 0x4ed8aa4a))
    (i32.store offset=2264 (i32.const 0) (i32.const 0x5b9cca4f)) (i32.store offset=2268 (i32.const 0) (i32.const 0x682e6ff3))
    (i32.store offset=2272 (i32.const 0) (i32.const 0x748f82ee)) (i32.store offset=2276 (i32.const 0) (i32.const 0x78a5636f))
    (i32.store offset=2280 (i32.const 0) (i32.const 0x84c87814)) (i32.store offset=2284 (i32.const 0) (i32.const 0x8cc70208))
    (i32.store offset=2288 (i32.const 0) (i32.const 0x90befffa)) (i32.store offset=2292 (i32.const 0) (i32.const 0xa4506ceb))
    (i32.store offset=2296 (i32.const 0) (i32.const 0xbef9a3f7)) (i32.store offset=2300 (i32.const 0) (i32.const 0xc67178f2)))

  (func $sha_init
    (i32.store offset=2304 (i32.const 0) (i32.const 0x6a09e667)) (i32.store offset=2308 (i32.const 0) (i32.const 0xbb67ae85))
    (i32.store offset=2312 (i32.const 0) (i32.const 0x3c6ef372)) (i32.store offset=2316 (i32.const 0) (i32.const 0xa54ff53a))
    (i32.store offset=2320 (i32.const 0) (i32.const 0x510e527f)) (i32.store offset=2324 (i32.const 0) (i32.const 0x9b05688c))
    (i32.store offset=2328 (i32.const 0) (i32.const 0x1f83d9ab)) (i32.store offset=2332 (i32.const 0) (i32.const 0x5be0cd19))
    (global.set $fill (i32.const 0))
    (global.set $len (i64.const 0)))

  (func $bswap (param $x i32) (result i32)
    (i32.or
      (i32.or (i32.shl (local.get $x) (i32.const 24)) (i32.and (i32.shl (local.get $x) (i32.const 8)) (i32.const 0xff0000)))
      (i32.or (i32.and (i32.shr_u (local.get $x) (i32.const 8)) (i32.const 0xff00)) (i32.shr_u (local.get $x) (i32.const 24)))))

  (func $sha_block
    (local $t i32) (local $q i32) (local $x i32) (local $y i32)
    (local $a i32) (local $b i32) (local $c i32) (local $d i32) (local $e i32) (local $f i32) (local $g i32) (local $h i32)
    (local $t1 i32) (local $t2 i32)
    (local.set $t (i32.const 0))
    (loop $w0
      (i32.store offset=2400 (i32.shl (local.get $t) (i32.const 2))
        (call $bswap (i32.load offset=2336 (i32.shl (local.get $t) (i32.const 2)))))
      (local.set $t (i32.add (local.get $t) (i32.const 1)))
      (br_if $w0 (i32.lt_u (local.get $t) (i32.const 16))))
    (loop $w1
      ;; q = address of W[t-16]
      (local.set $q (i32.add (i32.const 2336) (i32.shl (local.get $t) (i32.const 2))))
      (local.set $x (i32.load offset=4 (local.get $q)))
      (local.set $y (i32.load offset=56 (local.get $q)))
      (i32.store offset=64 (local.get $q)
        (i32.add
          (i32.add (i32.load (local.get $q))
            (i32.xor (i32.xor (i32.rotr (local.get $x) (i32.const 7)) (i32.rotr (local.get $x) (i32.const 18)))
                     (i32.shr_u (local.get $x) (i32.const 3))))
          (i32.add (i32.load offset=36 (local.get $q))
            (i32.xor (i32.xor (i32.rotr (local.get $y) (i32.const 17)) (i32.rotr (local.get $y) (i32.const 19)))
                     (i32.shr_u (local.get $y) (i32.const 10))))))
      (local.set $t (i32.add (local.get $t) (i32.const 1)))
      (br_if $w1 (i32.lt_u (local.get $t) (i32.const 64))))
    (local.set $a (i32.load offset=2304 (i32.const 0)))
    (local.set $b (i32.load offset=2308 (i32.const 0)))
    (local.set $c (i32.load offset=2312 (i32.const 0)))
    (local.set $d (i32.load offset=2316 (i32.const 0)))
    (local.set $e (i32.load offset=2320 (i32.const 0)))
    (local.set $f (i32.load offset=2324 (i32.const 0)))
    (local.set $g (i32.load offset=2328 (i32.const 0)))
    (local.set $h (i32.load offset=2332 (i32.const 0)))
    (local.set $t (i32.const 0))
    (loop $r
      (local.set $t1
        (i32.add
          (i32.add (local.get $h)
            (i32.xor (i32.xor (i32.rotr (local.get $e) (i32.const 6)) (i32.rotr (local.get $e) (i32.const 11)))
                     (i32.rotr (local.get $e) (i32.const 25))))
          (i32.add
            (i32.xor (i32.and (local.get $e) (local.get $f)) (i32.and (i32.xor (local.get $e) (i32.const -1)) (local.get $g)))
            (i32.add (i32.load offset=2048 (i32.shl (local.get $t) (i32.const 2)))
                     (i32.load offset=2400 (i32.shl (local.get $t) (i32.const 2)))))))
      (local.set $t2
        (i32.add
          (i32.xor (i32.xor (i32.rotr (local.get $a) (i32.const 2)) (i32.rotr (local.get $a) (i32.const 13)))
                   (i32.rotr (local.get $a) (i32.const 22)))
          (i32.xor (i32.xor (i32.and (local.get $a) (local.get $b)) (i32.and (local.get $a) (local.get $c)))
                   (i32.and (local.get $b) (local.get $c)))))
      (local.set $h (local.get $g))
      (local.set $g (local.get $f))
      (local.set $f (local.get $e))
      (local.set $e (i32.add (local.get $d) (local.get $t1)))
      (local.set $d (local.get $c))
      (local.set $c (local.get $b))
      (local.set $b (local.get $a))
      (local.set $a (i32.add (local.get $t1) (local.get $t2)))
      (local.set $t (i32.add (local.get $t) (i32.const 1)))
      (br_if $r (i32.lt_u (local.get $t) (i32.const 64))))
    (i32.store offset=2304 (i32.const 0) (i32.add (i32.load offset=2304 (i32.const 0)) (local.get $a)))
    (i32.store offset=2308 (i32.const 0) (i32.add (i32.load offset=2308 (i32.const 0)) (local.get $b)))
    (i32.store offset=2312 (i32.const 0) (i32.add (i32.load offset=2312 (i32.const 0)) (local.get $c)))
    (i32.store offset=2316 (i32.const 0) (i32.add (i32.load offset=2316 (i32.const 0)) (local.get $d)))
    (i32.store offset=2320 (i32.const 0) (i32.add (i32.load offset=2320 (i32.const 0)) (local.get $e)))
    (i32.store offset=2324 (i32.const 0) (i32.add (i32.load offset=2324 (i32.const 0)) (local.get $f)))
    (i32.store offset=2328 (i32.const 0) (i32.add (i32.load offset=2328 (i32.const 0)) (local.get $g)))
    (i32.store offset=2332 (i32.const 0) (i32.add (i32.load offset=2332 (i32.const 0)) (local.get $h))))

  (func $sha_byte (param $b i32)
    (i32.store8 offset=2336 (global.get $fill) (local.get $b))
    (global.set $fill (i32.add (global.get $fill) (i32.const 1)))
    (global.set $len (i64.add (global.get $len) (i64.const 1)))
    (if (i32.eq (global.get $fill) (i32.const 64))
      (then (call $sha_block) (global.set $fill (i32.const 0)))))

  (func $sha_final (param $out i32)
    (local $bits i64) (local $k i32)
    (local.set $bits (i64.shl (global.get $len) (i64.const 3)))
    (call $sha_byte (i32.const 128))
    (block $d (loop $l
      (br_if $d (i32.eq (global.get $fill) (i32.const 56)))
      (call $sha_byte (i32.const 0))
      (br $l)))
    (local.set $k (i32.const 56))
    (loop $lb
      (call $sha_byte (i32.wrap_i64 (i64.and (i64.shr_u (local.get $bits) (i64.extend_i32_u (local.get $k))) (i64.const 255))))
      (local.set $k (i32.sub (local.get $k) (i32.const 8)))
      (br_if $lb (i32.ge_s (local.get $k) (i32.const 0))))
    (local.set $k (i32.const 0))
    (loop $lo
      (i32.store (i32.add (local.get $out) (local.get $k)) (call $bswap (i32.load offset=2304 (local.get $k))))
      (local.set $k (i32.add (local.get $k) (i32.const 4)))
      (br_if $lo (i32.lt_u (local.get $k) (i32.const 32)))))

  ;; SHA-256 of the reflex text in slot $s
  (func $digest (param $s i32) (param $out i32)
    (call $digr (i32.load offset=20 (local.get $s)) (i32.load offset=24 (local.get $s)) (local.get $out)))

  (func $digr (param $i i32) (param $e i32) (param $out i32)
    (call $sha_init)
    (block $d (loop $l
      (br_if $d (i32.ge_u (local.get $i) (local.get $e)))
      (call $sha_byte (i32.load8_u (local.get $i)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l)))
    (call $sha_final (local.get $out)))

  ;; ================= writing =================
  (func $putc (param $c i32)
    (i32.store8 (global.get $o) (local.get $c))
    (global.set $o (i32.add (global.get $o) (i32.const 1))))

  (func $puts (param $a i32)
    (local $c i32)
    (block $done (loop $next
      (local.set $c (i32.load8_u (local.get $a)))
      (br_if $done (i32.eqz (local.get $c)))
      (call $putc (local.get $c))
      (local.set $a (i32.add (local.get $a) (i32.const 1)))
      (br $next))))

  (func $putu (param $v i64)
    (local $q i32)
    (local.set $q (i32.const 2880))
    (loop $next
      (local.set $q (i32.sub (local.get $q) (i32.const 1)))
      (i32.store8 (local.get $q) (i32.add (i32.const 48) (i32.wrap_i64 (i64.rem_u (local.get $v) (i64.const 10)))))
      (local.set $v (i64.div_u (local.get $v) (i64.const 10)))
      (br_if $next (i64.ne (local.get $v) (i64.const 0))))
    (block $done (loop $copy
      (br_if $done (i32.ge_u (local.get $q) (i32.const 2880)))
      (call $putc (i32.load8_u (local.get $q)))
      (local.set $q (i32.add (local.get $q) (i32.const 1)))
      (br $copy))))

  (func $puti (param $v i32) (call $putu (i64.extend_i32_u (local.get $v))))

  (func $putcode (param $c i32)
    (if (i32.eq (local.get $c) (i32.const 65535))
      (then (call $putc (i32.const 45)) (call $putc (i32.const 49)))
      (else (call $puti (local.get $c)))))

  (func $puthex (param $a i32)
    (local $i i32) (local $b i32) (local $n i32)
    (call $putc (i32.const 34))
    (loop $l
      (local.set $b (i32.load8_u (i32.add (local.get $a) (local.get $i))))
      (local.set $n (i32.shr_u (local.get $b) (i32.const 4)))
      (call $putc (select (i32.add (local.get $n) (i32.const 48)) (i32.add (local.get $n) (i32.const 87)) (i32.lt_u (local.get $n) (i32.const 10))))
      (local.set $n (i32.and (local.get $b) (i32.const 15)))
      (call $putc (select (i32.add (local.get $n) (i32.const 48)) (i32.add (local.get $n) (i32.const 87)) (i32.lt_u (local.get $n) (i32.const 10))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (i32.const 32))))
    (call $putc (i32.const 34)))

  (func $tail
    (call $puts (i32.const 1536))
    (call $putu (global.get $seq))
    (call $puts (i32.const 1568)))

  ;; ================= ops =================
  (func $do_run
    (local $idx i32) (local $i i32) (local $v i32) (local $sz i32) (local $n i32) (local $k i32)
    (local.set $n (i32.load offset=4 (i32.const 65536)))
    (if (i32.eq (global.get $casemode) (i32.const 1))
      (then
        (if (i32.ne (global.get $ncase) (local.get $n)) (then (call $seterr (i32.const 6)) (return)))
        (block $d (loop $l
          (br_if $d (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $v (i32.load offset=2944 (i32.shl (local.get $i) (i32.const 2))))
          (local.set $sz (i32.load offset=32 (i32.add (i32.const 65536) (i32.shl (local.get $i) (i32.const 2)))))
          (if (i32.ge_u (local.get $v) (local.get $sz)) (then (call $seterr (i32.const 6)) (return)))
          (local.set $idx (i32.add (i32.mul (local.get $idx) (local.get $sz)) (local.get $v)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l))))
      (else
        (local.set $idx (global.get $pidx))
        (if (i32.ge_u (local.get $idx) (i32.load offset=8 (i32.const 65536))) (then (call $seterr (i32.const 6)) (return)))))
    (local.set $k (call $eval (i32.const 65536) (local.get $idx)))
    (if (i32.eq (local.get $k) (i32.const 65535)) (then (call $seterr (i32.const 7)) (return)))
    (call $digest (i32.const 65536) (i32.const 2688))
    (call $puts (i32.const 1024))
    (call $puts (i32.const 2880))
    (call $puti (local.get $k))
    (call $puts (i32.const 3648))
    (call $puti (call $inesc (local.get $k)))
    (call $puts (i32.const 288))
    (call $puthex (i32.const 2688))
    (call $puts (i32.const 2912))
    (call $puti (local.get $idx))
    (call $tail))

  (func $do_census
    (local $i i32) (local $d i32) (local $space i32) (local $o i32) (local $inv i32) (local $first i32) (local $c i32)
    (local.set $d (i32.load offset=8 (i32.const 65536)))
    (call $outcomes (i32.const 65536) (i32.const 196608))
    (if (i32.eq (i32.load (i32.const 65536)) (i32.const 1))
      (then (local.set $space (i32.load offset=12 (i32.const 65536))))
      (else
        (local.set $space (i32.load offset=180 (i32.const 65536)))
        (if (i32.load offset=176 (i32.const 65536))
          (then (local.set $space (i32.shl (i32.const 1) (local.get $space)))))))
    (local.set $i (i32.const 0))
    (block $zd (loop $zl
      (br_if $zd (i32.ge_u (local.get $i) (local.get $space)))
      (i32.store16 offset=131072 (i32.shl (local.get $i) (i32.const 1)) (i32.const 0))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $zl)))
    (local.set $i (i32.const 0))
    (block $cd (loop $cl
      (br_if $cd (i32.ge_u (local.get $i) (local.get $d)))
      (local.set $o (i32.load16_u offset=196608 (i32.shl (local.get $i) (i32.const 1))))
      (if (i32.eq (local.get $o) (i32.const 65535))
        (then (local.set $inv (i32.add (local.get $inv) (i32.const 1))))
        (else (i32.store16 offset=131072 (i32.shl (local.get $o) (i32.const 1))
                (i32.add (i32.load16_u offset=131072 (i32.shl (local.get $o) (i32.const 1))) (i32.const 1)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $cl)))
    (call $digest (i32.const 65536) (i32.const 2688))
    (call $puts (i32.const 1024))
    (call $puts (i32.const 1056))
    (call $puti (local.get $d))
    (call $puts (i32.const 1376))
    (local.set $first (i32.const 1))
    (local.set $i (i32.const 0))
    (block $ed (loop $el
      (br_if $ed (i32.ge_u (local.get $i) (local.get $space)))
      (local.set $c (i32.load16_u offset=131072 (i32.shl (local.get $i) (i32.const 1))))
      (if (local.get $c)
        (then
          (if (i32.eqz (local.get $first)) (then (call $putc (i32.const 44))))
          (local.set $first (i32.const 0))
          (call $putc (i32.const 91))
          (call $puti (local.get $i))
          (call $putc (i32.const 44))
          (call $puti (local.get $c))
          (call $putc (i32.const 93))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $el)))
    (call $putc (i32.const 93))
    (call $puts (i32.const 1216))
    (call $puti (local.get $inv))
    (call $puts (i32.const 288))
    (call $puthex (i32.const 2688))
    (call $tail))

  ;; nucleus: reflex.digest. The SHA-256 of the reflex's canonical bytes (its identity: two bodies hold the same reflex
  ;; exactly when these agree), the SHA-256 of its escalation definition, its byte length and its domain size.
  (func $do_digest
    (call $digest (i32.const 65536) (i32.const 2688))
    (call $digr (i32.load offset=460 (i32.const 65536)) (i32.load offset=464 (i32.const 65536)) (i32.const 2784))
    (call $puts (i32.const 1024))
    (call $puts (i32.const 3008))
    (call $puti (i32.sub (i32.load offset=24 (i32.const 65536)) (i32.load offset=20 (i32.const 65536))))
    (call $putc (i32.const 44))
    (call $puts (i32.const 1056))
    (call $puti (i32.load offset=8 (i32.const 65536)))
    (call $puts (i32.const 3648))
    (call $puthex (i32.const 2784))
    (call $puts (i32.const 288))
    (call $puthex (i32.const 2688))
    (call $tail))

  ;; reflex.diff (the lab's reflex.atlas): before = slot A (old), after = slot B (new).
  (func $do_diff
    (local $i i32) (local $d i32) (local $n i32) (local $a i32) (local $b i32) (local $ch i32) (local $inv i32)
    (local $rem i32) (local $bec i32) (local $listed i32) (local $dif i32) (local $la i32) (local $lb i32)
    ;; nucleus: the stated domain is the before reflex's domain
    (local.set $n (i32.load offset=4 (i32.const 65536)))
    (if (i32.ne (local.get $n) (global.get $dn)) (then (call $seterr (i32.const 5)) (return)))
    (block $td (loop $tl
      (br_if $td (i32.ge_u (local.get $i) (local.get $n)))
      (if (i32.ne (i32.load offset=32 (i32.add (i32.const 65536) (i32.shl (local.get $i) (i32.const 2))))
                  (i32.load offset=3904 (i32.shl (local.get $i) (i32.const 2))))
        (then (call $seterr (i32.const 5)) (return)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $tl)))
    (local.set $i (i32.const 0))
    ;; same domain
    (if (i32.ne (local.get $n) (i32.load offset=4 (i32.const 131072))) (then (call $seterr (i32.const 5)) (return)))
    (block $sd (loop $sl
      (br_if $sd (i32.ge_u (local.get $i) (local.get $n)))
      (if (i32.ne (i32.load offset=32 (i32.add (i32.const 65536) (i32.shl (local.get $i) (i32.const 2))))
                  (i32.load offset=32 (i32.add (i32.const 131072) (i32.shl (local.get $i) (i32.const 2)))))
        (then (call $seterr (i32.const 5)) (return)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $sl)))
    (local.set $d (i32.load offset=8 (i32.const 65536)))
    (call $outcomes (i32.const 65536) (i32.const 196608))
    (call $outcomes (i32.const 131072) (i32.const 229376))
    ;; pass 1: counts and the checksum over every changed case
    (call $sha_init)
    (local.set $i (i32.const 0))
    (block $pd (loop $pl
      (br_if $pd (i32.ge_u (local.get $i) (local.get $d)))
      (local.set $a (i32.load16_u offset=196608 (i32.shl (local.get $i) (i32.const 1))))
      (local.set $b (i32.load16_u offset=229376 (i32.shl (local.get $i) (i32.const 1))))
      (if (i32.ne (local.get $a) (local.get $b))
        (then
          (local.set $ch (i32.add (local.get $ch) (i32.const 1)))
          (call $sha_byte (i32.shr_u (local.get $i) (i32.const 24)))
          (call $sha_byte (i32.and (i32.shr_u (local.get $i) (i32.const 16)) (i32.const 255)))
          (call $sha_byte (i32.and (i32.shr_u (local.get $i) (i32.const 8)) (i32.const 255)))
          (call $sha_byte (i32.and (local.get $i) (i32.const 255)))
          (call $sha_byte (i32.shr_u (local.get $a) (i32.const 8)))
          (call $sha_byte (i32.and (local.get $a) (i32.const 255)))
          (call $sha_byte (i32.shr_u (local.get $b) (i32.const 8)))
          (call $sha_byte (i32.and (local.get $b) (i32.const 255)))))
      (if (i32.or (i32.eq (local.get $a) (i32.const 65535)) (i32.eq (local.get $b) (i32.const 65535)))
        (then (local.set $inv (i32.add (local.get $inv) (i32.const 1)))))
      (if (call $isrem (local.get $a) (local.get $b))
        (then (local.set $rem (i32.add (local.get $rem) (i32.const 1)))))
      (if (call $isbec (local.get $a) (local.get $b))
        (then (local.set $bec (i32.add (local.get $bec) (i32.const 1)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $pl)))
    (call $sha_final (i32.const 2752))
    (call $digest (i32.const 131072) (i32.const 2720))
    (call $digest (i32.const 65536) (i32.const 2688))
    (call $digr (i32.load offset=460 (i32.const 65536)) (i32.load offset=464 (i32.const 65536)) (i32.const 2784))
    ;; escalate_differs: the two definitions' bytes
    (local.set $la (i32.sub (i32.load offset=464 (i32.const 65536)) (i32.load offset=460 (i32.const 65536))))
    (local.set $lb (i32.sub (i32.load offset=464 (i32.const 131072)) (i32.load offset=460 (i32.const 131072))))
    (if (i32.ne (local.get $la) (local.get $lb))
      (then (local.set $dif (i32.const 1)))
      (else
        (local.set $i (i32.const 0))
        (block $xd (loop $xl
          (br_if $xd (i32.ge_u (local.get $i) (local.get $la)))
          (if (i32.ne (i32.load8_u (i32.add (i32.load offset=460 (i32.const 65536)) (local.get $i)))
                      (i32.load8_u (i32.add (i32.load offset=460 (i32.const 131072)) (local.get $i))))
            (then (local.set $dif (i32.const 1)) (br $xd)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $xl)))))
    (call $puts (i32.const 1024))
    (call $puts (i32.const 3040))
    (call $puthex (i32.const 2720))
    (call $putc (i32.const 44))
    ;; became_invalid: every index, never truncated
    (call $puts (i32.const 3584))
    (local.set $listed (i32.const 0))
    (local.set $i (i32.const 0))
    (block $bd (loop $bl
      (br_if $bd (i32.ge_u (local.get $i) (local.get $d)))
      (if (call $isbec (i32.load16_u offset=196608 (i32.shl (local.get $i) (i32.const 1)))
                       (i32.load16_u offset=229376 (i32.shl (local.get $i) (i32.const 1))))
        (then
          (if (local.get $listed) (then (call $putc (i32.const 44))))
          (call $puti (local.get $i))
          (local.set $listed (i32.const 1))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $bl)))
    (call $puts (i32.const 3616))
    (call $puti (local.get $bec))
    (call $puts (i32.const 224))
    (call $puthex (i32.const 2688))
    (call $putc (i32.const 44))
    (call $puts (i32.const 1056))
    (call $puti (local.get $d))
    (call $puts (i32.const 1088))
    (call $puti (local.get $ch))
    (call $puts (i32.const 1120))
    ;; pass 2: the listing, at most cap entries
    (local.set $listed (i32.const 0))
    (local.set $i (i32.const 0))
    (block $qd (loop $ql
      (br_if $qd (i32.ge_u (local.get $i) (local.get $d)))
      (br_if $qd (i32.ge_u (local.get $listed) (global.get $cap)))
      (local.set $a (i32.load16_u offset=196608 (i32.shl (local.get $i) (i32.const 1))))
      (local.set $b (i32.load16_u offset=229376 (i32.shl (local.get $i) (i32.const 1))))
      (if (i32.ne (local.get $a) (local.get $b))
        (then
          (if (local.get $listed) (then (call $putc (i32.const 44))))
          (call $putc (i32.const 91))
          (call $puti (local.get $i))
          (call $putc (i32.const 44))
          (call $putcode (local.get $a))
          (call $putc (i32.const 44))
          (call $putcode (local.get $b))
          (call $putc (i32.const 93))
          (local.set $listed (i32.add (local.get $listed) (i32.const 1)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $ql)))
    (call $puts (i32.const 1152))
    (call $puthex (i32.const 2752))
    (call $puts (i32.const 3648))
    (call $puthex (i32.const 2784))
    (call $puts (i32.const 3680))
    (call $puti (local.get $dif))
    (call $puts (i32.const 3712))
    (call $puti (local.get $rem))
    ;; escalations_removed_list: every index, never truncated
    (call $puts (i32.const 3744))
    (local.set $listed (i32.const 0))
    (local.set $i (i32.const 0))
    (block $rd (loop $rl
      (br_if $rd (i32.ge_u (local.get $i) (local.get $d)))
      (if (call $isrem (i32.load16_u offset=196608 (i32.shl (local.get $i) (i32.const 1)))
                       (i32.load16_u offset=229376 (i32.shl (local.get $i) (i32.const 1))))
        (then
          (if (local.get $listed) (then (call $putc (i32.const 44))))
          (call $puti (local.get $i))
          (local.set $listed (i32.const 1))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $rl)))
    (call $putc (i32.const 93))
    (call $puts (i32.const 1216))
    (call $puti (local.get $inv))
    (call $puts (i32.const 1312))
    (call $puti (i32.gt_u (local.get $ch) (global.get $cap)))
    (call $puts (i32.const 1344))
    (call $puti (i32.sub (local.get $d) (local.get $ch)))
    (call $tail))

  (func $refuse
    (global.set $o (i32.const 524288))
    (call $puts (i32.const 1600))
    (call $puts (i32.add (i32.const 1632) (i32.shl (global.get $err) (i32.const 5))))
    (call $putc (i32.const 34))
    (if (global.get $withseq)
      (then (call $puts (i32.const 448)) (call $putu (global.get $seq))))
    (call $puts (i32.const 1632)))

  ;; ================= ABI =================
  (func (export "mv_abi_version") (result i32) (i32.const 1))

  (func (export "mv_alloc") (param $len i32) (result i32)
    (if (result i32) (i32.le_u (local.get $len) (i32.const 262144))
      (then (i32.const 262144))
      (else (i32.const 0))))

  (func (export "mv_run") (param $ptr i32) (param $len i32) (result i64)
    (local $v i64)
    (global.set $err (i32.const 0))
    (global.set $withseq (i32.const 0))
    (global.set $seq (i64.const 0))
    (global.set $o (i32.const 524288))
    (global.set $form (i32.const 0))
    (global.set $op (i32.const 0))
    (global.set $casemode (i32.const 0))
    (global.set $ncase (i32.const 0))
    (global.set $pidx (i32.const 0))
    (global.set $cap (i32.const 0))
    (global.set $dn (i32.const 0))
    (call $sha_consts)
    (if (i32.or (i32.ne (local.get $ptr) (i32.const 262144)) (i32.gt_u (local.get $len) (i32.const 262144)))
      (then (call $seterr (i32.const 1)))
      (else
        (global.set $p (local.get $ptr))
        (global.set $end (i32.add (local.get $ptr) (local.get $len)))
        (call $lit (i32.const 64))
        (if (call $try (i32.const 96))
          (then
            ;; reflex.diff: {"after":R,"before":R,"cap":L,"domain":[..]}
            (global.set $form (i32.const 3))
            (call $reflex (i32.const 131072))
            (call $lit (i32.const 224))
            (call $reflex (i32.const 65536))
            (call $lit (i32.const 256))
            (global.set $cap (call $intr (i64.const 0) (i64.const 16384) (i32.const 3)))
            (call $domparse))
          (else
            (if (call $try (i32.const 128))
              (then
                ;; reflex.run: {"input":case,"reflex":R}
                (global.set $form (i32.const 1))
                (call $caseparse)
                (call $lit (i32.const 288))
                (call $reflex (i32.const 65536)))
              (else
                (if (call $try (i32.const 160))
                  (then
                    ;; reflex.census and reflex.digest: {"reflex":R}
                    (global.set $form (i32.const 2))
                    (call $reflex (i32.const 65536)))
                  (else (call $seterr (i32.const 1))))))))
        (call $lit (i32.const 320))
        (if (call $try (i32.const 352)) (then (global.set $op (i32.const 1)))
          (else (if (call $try (i32.const 384)) (then (global.set $op (i32.const 2)))
            (else (if (call $try (i32.const 416)) (then (global.set $op (i32.const 3)))
              (else (if (call $try (i32.const 2016)) (then (global.set $op (i32.const 4)))
                (else (call $seterr (i32.const 2))))))))))
        (call $lit (i32.const 448))
        (local.set $v (call $int))
        (if (i64.lt_s (local.get $v) (i64.const 0)) (then (call $seterr (i32.const 1))))
        (global.set $seq (local.get $v))
        (call $eat (i32.const 125))
        (if (i32.ne (global.get $p) (global.get $end)) (then (call $seterr (i32.const 1))))
        (if (i32.eqz (global.get $err))
          (then
            (global.set $withseq (i32.const 1))
            (if (i32.ne (select (i32.const 2) (global.get $op) (i32.eq (global.get $op) (i32.const 4))) (global.get $form))
              (then (call $seterr (i32.const 2))))
            (if (i32.load offset=28 (i32.const 65536)) (then (call $seterr (i32.const 4))))
            (if (i32.and (i32.eq (global.get $form) (i32.const 3)) (i32.load offset=28 (i32.const 131072)))
              (then (call $seterr (i32.const 4))))
            (if (i32.eqz (global.get $err))
              (then
                (if (i32.eq (global.get $form) (i32.const 1)) (then (call $do_run)))
                (if (i32.eq (global.get $op) (i32.const 2)) (then (call $do_census)))
                (if (i32.eq (global.get $op) (i32.const 4)) (then (call $do_digest)))
                (if (i32.eq (global.get $form) (i32.const 3)) (then (call $do_diff)))))))))
    (if (global.get $err) (then (call $refuse)))
    (i64.or
      (i64.shl (i64.extend_i32_u (i32.sub (global.get $o) (i32.const 524288))) (i64.const 32))
      (i64.const 524288))))
