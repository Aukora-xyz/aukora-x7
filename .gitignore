# Unselected local proposals may contain private configuration.
mirror/balls/forks/

# ── aukora-x7: a node's own world never enters this repository ─────────────────────────────────────────────────────
# server/local-host.mjs keeps a node's live state under mirror/. Only the genesis seed is tracked: the two heads, the
# seed organ modules, the seed organ library and the two Pearl seed files. Everything else a node writes there stays local.
/mirror/*
!/mirror/balls/
!/mirror/home/
/mirror/balls/*
!/mirror/balls/HEAD.json
!/mirror/balls/*.js
/mirror/home/*
!/mirror/home/balls/
!/mirror/home/auma/
/mirror/home/balls/*
!/mirror/home/balls/HEAD.json
!/mirror/home/balls/*.js
/mirror/home/auma/*
!/mirror/home/auma/HEAD.json
!/mirror/home/auma/seed/
/mirror/home/auma/seed/*
!/mirror/home/auma/seed/organs/
!/mirror/home/auma/seed/pearl/
!/mirror/home/auma/seed/scars.jsonl
/mirror/home/auma/seed/pearl/*
!/mirror/home/auma/seed/pearl/retention-suite.v1.json
# Defence in depth for keys and local secrets anywhere in the tree.
